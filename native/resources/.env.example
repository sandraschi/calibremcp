# CalibreMCP Environment Configuration — SINGLE SOURCE OF TRUTH (repo-root .env)
# Copy this file to .env and update with your actual values.
# Do NOT create webapp/.env or webapp/backend/.env duplicates: the Python
# MCP server (src/calibre_mcp/config.py, server.py) and the FastAPI backend
# (webapp/backend/app/main.py) all load this repo-root .env explicitly.

# Calibre Server Connection
CALIBRE_SERVER_URL=http://localhost:8099
CALIBRE_USERNAME=your-calibre-username
CALIBRE_PASSWORD=your-calibre-password

# Library Configuration
# Option 1: Set a base path to auto-discover libraries as subdirectories
CALIBRE_BASE_PATH=L:/Multimedia Files/Written Word

# Performance Settings
CALIBRE_TIMEOUT=30
CALIBRE_MAX_RETRIES=3
CALIBRE_DEFAULT_LIMIT=50
CALIBRE_MAX_LIMIT=200

# Library Settings
CALIBRE_LIBRARY_NAME=Sandra's Library

# Anna's Archive (manage_import annas_search)
# Comma-separated mirror URLs; defaults used if not set
# ANNAS_MIRRORS=https://annas-archive.org,https://annas-archive.li,https://annas-archive.se

# MCP Bridge: comma-separated URLs for proxy upstream servers
# MCP_BRIDGE_URLS=http://host1:port1/path,http://host2:port2/path

# Development/Debug Settings
CALIBRE_DEBUG=0

# Backend / frontend single-source runtime (fleet ports 10720/10721).
# Canonical: backend binds 127.0.0.1:10720, frontend on 10721.
HOST=127.0.0.1
PORT=10720
CORS_ORIGINS=http://localhost:10721,http://127.0.0.1:10721
NEXT_PUBLIC_API_URL=http://127.0.0.1:10720
MCP_USE_HTTP=false
BACKEND_URL=http://127.0.0.1:10720
# CALIBRE_CONFIG_PATH=config.json
