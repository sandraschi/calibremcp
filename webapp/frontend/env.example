# API URL (backend). Use 10720 when using reservoir ports (start.ps1).
NEXT_PUBLIC_API_URL=http://127.0.0.1:10720

# App URL for server-side fetch (Next.js). Must match frontend port so SSR fetch hits this server.
# Use 10721 for reservoir (start.ps1), 13001 for start-local.bat.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:10721

# Fleet **tvtropes-mcp** webapp (local mirror UI). Book modal TV Tropes links use `/?lookup=Literature/...`.
# See tvtropes-mcp/docs/CROSS_MCP.md. Set to `0` or `false` to disable fleet mirror links.
# NEXT_PUBLIC_TVTROPES_MCP_URL=http://127.0.0.1:10965

# Optional legacy: wrap direct https://tvtropes.org/... when fleet mirror is off. Prefer tvtropes-mcp above.
#   NEXT_PUBLIC_TVTROPES_VIA=https://proxy.example/read?target={url}
#   NEXT_PUBLIC_TVTROPES_VIA=https://proxy.example/go?u=
#   NEXT_PUBLIC_TVTROPES_VIA=jina:https://r.jina.ai
# NEXT_PUBLIC_TVTROPES_VIA=
